# MySQL 서버 접속 주소: 스키마가 없어도 생성할 수 있도록 서버까지만 작성합니다.
DB_SERVER_URL=jdbc:mysql://localhost:3306/

# 애플리케이션에서 사용할 atumari 스키마 접속 주소
DB_URL=jdbc:mysql://localhost:3306/atumari?createDatabaseIfNotExist=true&useUnicode=true&characterEncoding=UTF-8&serverTimezone=Asia/Seoul
DB_USERNAME=root
DB_PASSWORD=change-me

# JPA는 나중에 사용하며, 현재 테이블은 database.sql로 관리합니다.
DDL_AUTO=none
SHOW_SQL=true

# Google 로그인을 구현할 때 입력합니다.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

SERVER_PORT=8080
