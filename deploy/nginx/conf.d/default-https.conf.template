limit_req_zone $binary_remote_addr zone=per_ip:10m rate=60r/s;

server {
    listen 80;
    listen [::]:80;
    server_name atumary.com;

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name atumary.com;

    ssl_certificate /etc/letsencrypt/live/atumary.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/atumary.com/privkey.pem;
    ssl_session_timeout 1d;
    ssl_session_cache shared:SSL:10m;
    ssl_session_tickets off;
    ssl_protocols TLSv1.2 TLSv1.3;

    client_max_body_size 40m;
    limit_req_status 429;

    location / {
        limit_req zone=per_ip burst=120 nodelay;

        proxy_pass http://spring:8080;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
